# Cairn ortam değişkenleri örneği.
# Bu dosya şablondur; gerçek değer içermez. Kopyala: cp .env.example .env
#
# EXPO_PUBLIC_ önekli değişkenler istemci paketine gömülür ve GİZLİ DEĞİLDİR.
# service_role anahtarı, özel API anahtarı veya herhangi bir sır buraya konmaz.

# Supabase proje URL'i (public)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable anahtarı (public, RLS ile korunur)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sunucu tarafı sırlar (Edge Function / CI secret olarak tutulur, bu dosyaya yazılmaz):
#   SUPABASE_SERVICE_ROLE_KEY  -> yalnız Supabase Vault / GitHub secret
